# Environment Variables for Airshine Orbit Solutions
# Copy this file to .env and fill in your values

# Site URL
VITE_SITE_URL=https://airshine-orbit-website.netlify.app

# Contact form email delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=Airshine Orbit Solutions
SMTP_FROM_EMAIL=your-email@gmail.com
SITE_URL=https://airshine-orbit-website.netlify.app
